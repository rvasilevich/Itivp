    {
      "name": "1.1 Регистрация demo-пользователя — POST /api/v1/auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:3000/api/v1/auth/register",
        "description": "Сохраняет userId, userEmail. Email должен быть уникален (иначе 409).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo.user2@example.com\",\n  \"password\": \"secret12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('userId', pm.response.json().id);",
              "pm.collectionVariables.set('userEmail', pm.response.json().email);"
            ]
          }
        }
      ]
    },
