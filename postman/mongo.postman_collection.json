        },
        {
          "name": "0.6 GET некорректный id → 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/api/v1/mongo/employees/not-an-objectid",
            "description": "Не ObjectId → Mongoose CastError → 400 \"Некорректный ID\". Именно это происходит, если написать в URL {{1}}: Postman отправит литерал {{1}}, а не число."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
