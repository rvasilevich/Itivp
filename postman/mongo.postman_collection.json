    {
      "name": "3. Валидация и негативные кейсы",
      "item": [
        {
          "name": "3.1 POST без name → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
