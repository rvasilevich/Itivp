    {
      "name": "2. Вложенные структуры (часть 6 задания)",
      "item": [
        {
          "name": "2.1 $push: добавить отзыв в reviews[]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:3000/api/v1/mongo/employees/{{mongoId}}/reviews",
            "description": "Оператор $push добавляет ВЛОЖЕННЫЙ документ внутрь массива reviews[] существующего документа. В реляционной модели это был бы INSERT в отдельную таблицу Reviews с внешним ключом. Сохраняет id нового отзыва в переменную reviewId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewer\": \"Менеджер\",\n  \"rating\": 9,\n  \"comment\": \"Хорошая работа\",\n  \"goals\": [\n    \"Повысить до senior\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"reviewId\", d.reviews[d.reviews.length - 1]._id);",
                  "pm.test(\"отзывов стало 2\", function () { pm.expect(d.reviews.length).to.eql(2); });",
                  "pm.test(\"у отзыва есть массив целей goals[]\", function () { pm.expect(d.reviews[1].goals).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 PUT отзыв — позиционный оператор $ (правка ВНУТРИ массива)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:3000/api/v1/mongo/employees/{{mongoId}}/reviews/{{reviewId}}",
            "description": "Обновляется только выбранный элемент массива: findOneAndUpdate с условием {\"reviews._id\": reviewId} и $set по \"reviews.$.rating\". Аналог UPDATE ... WHERE id = ... в реляционной модели, но без отдельной таблицы.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Обновлённый комментарий\",\n  \"rating\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "const rev = d.reviews[d.reviews.length - 1];",
                  "pm.test(\"rating отзыва изменён на 10\", function () { pm.expect(rev.rating).to.eql(10); });",
                  "pm.test(\"комментарий изменён\", function () { pm.expect(rev.comment).to.eql(\"Обновлённый комментарий\"); });"
                ]
              }
            }
          ]
        },
