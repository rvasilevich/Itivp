          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:3000/api/v1/mongo/employees/{{seedId}}",
            "description": "Демонстрация отличия от реляционной модели: в PostgreSQL это был бы SELECT сотрудника плюс два JOIN (навыки, отзывы) либо три запроса; здесь весь агрегат приходит одним документом, а вложенные массивы видны прямо в ответе. Переменная seedId заполняется в 0.1 (демо-документ \"Иван Иванов\")."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json();",
                  "pm.test(\"skills[] и reviews[] непустые\", function () { pm.expect(d.skills.length).to.be.above(0); pm.expect(d.reviews.length).to.be.above(0); });",
                  "pm.test(\"у вложенных документов свой _id\", function () { pm.expect(d.reviews[0]._id).to.be.a(\"string\"); pm.expect(d.skills[0]._id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        }
