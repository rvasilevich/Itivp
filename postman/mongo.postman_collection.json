                  "pm.test(\"rating обновился\", function () { pm.expect(d.rating).to.eql(9.3); });",
                  "pm.test(\"вложенные массивы не потерялись\", function () { pm.expect(d.skills.length).to.be.above(0); pm.expect(d.reviews.length).to.be.above(0); });"
