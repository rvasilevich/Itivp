# ─────────────────────────────────────────────────────────────────────────────
# Шаблон НЕОБЯЗАТЕЛЬНЫХ переменных для Docker (ЛР №8).
#
# docker-compose.yml сам читает файл `.env` корня проекта и подставляет `${...}`.
# Если `.env` нет — используются значения по умолчанию, и весь стек (включая
# БД) поднимается локально, без интернета.
#
# Чтобы переопределить поведение — ДОБАВЬТЕ нужные строки в существующий `.env`
# (не создавайте второй файл: compose читает только `.env`).
# ─────────────────────────────────────────────────────────────────────────────

# Хост-порт backend-а (в контейнере сервер всегда слушает 5000).
# По умолчанию 5001, т.к. на macOS порт 5000 занят AirPlay Receiver.
# BACKEND_PORT=5000

# Хост-порт frontend-а (nginx). По умолчанию 80 → http://localhost
# FRONTEND_PORT=80

# Хост-порт веб-интерфейса MongoDB. По умолчанию 8081
# MONGO_EXPRESS_PORT=8081

# Реляционная БД внутри контейнера: логин/пароль/имя (см. docker-compose.yml).
# Меняя их, синхронно правьте DATABASE_URL ниже.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=employee_eval

# Строка подключения PostgreSQL для backend-а. По умолчанию — контейнер `postgres`.
# Чтобы использовать облачный Supabase, раскомментируйте и подставьте свой URL:
# DOCKER_DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Секрет для подписи JWT (ЛР №3/№7). Если не задан — используется dev-значение.
# JWT_SECRET=change-me-in-production

# Строка подключения MongoDB (по умолчанию — контейнер `mongo`).
# MONGO_URI=mongodb://mongo:27017/employee_eval

# Накатывать миграции и сиды при старте backend-а ("true"/"false").
# RUN_MIGRATIONS=true
